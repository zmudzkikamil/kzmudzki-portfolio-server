# PostgreSQL connection string (Supabase: Project Settings → Database → URI)
DATABASE_URL=

# Force SSL on or off for that connection (optional). Left unset, a
# localhost URL connects unencrypted - a Postgres on your own machine has
# ssl = off and refuses an encrypted connection - and everything else,
# Supabase included, connects over SSL.
DATABASE_SSL=

# Resend API key for contact form emails (resend.com)
RESEND_API_KEY=

# Email address that receives contact form submissions
RECIPIENT_EMAIL=

# Comma-separated list of allowed CORS origins. A domain listed here also
# admits its www. counterpart (and a www. host its bare domain), so serving the
# site from www.zkamil.eu rather than zkamil.eu needs no change here.
CORS_ORIGINS=http://localhost:5173

# Server port (optional, defaults to 3000)
PORT=3000
